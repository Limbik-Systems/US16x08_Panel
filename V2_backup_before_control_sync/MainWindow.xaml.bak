<Window x:Class="US16x08_AbletonPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:US16x08_AbletonPanel.Controls"
        mc:Ignorable="d"
        Title="TASCAM US-16x08 // Ableton Live DSP &amp; MIDI Console V2"
        Width="1560"
        Height="920"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AbletonWindowBg}"
        Foreground="{StaticResource AbletonTextPrimary}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Ableton Transport & Global Hardware Bar -->
            <RowDefinition Height="52"/>
            <!-- Secondary Scene & View Mode Sub-Bar -->
            <RowDefinition Height="38"/>
            <!-- Main Workspace Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Ableton Status Bar -->
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ======================================================================= -->
        <!-- ROW 0: TOP ABLETON LIVE TRANSPORT & HARDWARE BAR                        -->
        <!-- ======================================================================= -->
        <Border Grid.Row="0" Background="#141414" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Title + Connection Pill -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFB000" CornerRadius="2" Padding="7,3" Margin="0,0,8,0">
                        <TextBlock Text="LIVE DSP V2" Foreground="#121212" FontWeight="Black" FontSize="11"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="TASCAM US-16x08" FontWeight="Bold" FontSize="14" Foreground="#F2F2F2"/>
                        <TextBlock Text="16×8 USB AUDIO DSP &amp; MIDI ROUTER" FontSize="9" Foreground="#888888" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Hardware Status Indicator -->
                    <Border Background="#222222" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="2" Padding="8,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#00D4FF"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHardwareConnected}" Value="True">
                                                <Setter Property="Fill" Value="#00E676"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="#E0E0E0"/>
                        </StackPanel>
                    </Border>

                    <!-- MIDI Status Indicator -->
                    <Border Background="#222222" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="2" Padding="8,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#FFB000" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding MidiBadgeText}" FontSize="10" FontWeight="Bold" Foreground="#FFB000"/>
                        </StackPanel>
                    </Border>

                    <Button Content="SCAN USB"
                            Command="{Binding ReconnectHardwareCommand}"
                            Style="{StaticResource AbletonButtonStyle}"
                            Margin="0,0,5,0"
                            ToolTip="Scan Windows SetupAPI KSCATEGORY_RENDER for physical TASCAM US-16x08 interface"/>

                    <Button Content="MIDI PANIC !"
                            Command="{Binding GlobalMidiPanicCommand}"
                            Style="{StaticResource AbletonButtonStyle}"
                            Foreground="#FF5252"
                            BorderBrush="#883333"
                            Margin="0,0,4,0"
                            ToolTip="Send All Notes Off (CC#123) + All Sound Off (CC#120) + Sustain Off (CC#64) on Ch 1-16 to all MIDI Outputs"/>
                </StackPanel>

                <!-- Audio Clock & ASIO Buffer Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Border Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="2" Padding="6,3" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RATE" FontSize="9" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding AvailableSampleRates}"
                                      SelectedItem="{Binding CurrentSampleRate}"
                                      Style="{StaticResource AbletonComboBoxStyle}"
                                      Width="76"/>
                            <TextBlock Text="Hz" FontSize="9" Foreground="#888888" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#202020" BorderBrush="#383838" BorderThickness="1" CornerRadius="2" Padding="6,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="BUFFER" FontSize="9" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox ItemsSource="{Binding AvailableBufferSizes}"
                                      SelectedItem="{Binding AsioBufferSize}"
                                      Style="{StaticResource AbletonComboBoxStyle}"
                                      Width="66"/>
                            <TextBlock Text="{Binding LatencyEstimateText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFB000" VerticalAlignment="Center" Margin="6,0,2,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Global Hardware Switches (Tag 0x44 & Tag 0x45) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="COMP OUT &#x2192; STEREO"
                                  IsChecked="{Binding ComputerToStereoBus}"
                                  Style="{StaticResource AbletonAmberToggleStyle}"
                                  Padding="8,5"
                                  Margin="0,0,6,0"
                                  ToolTip="TLV Tag 0x44: Route DAW Computer Output 1/2 to the hardware Stereo Master Bus"/>

                    <ToggleButton Content="TRUE BYPASS"
                                  IsChecked="{Binding TrueBypass}"
                                  Style="{StaticResource AbletonCyanToggleStyle}"
                                  Padding="8,5"
                                  Margin="0,0,6,0"
                                  ToolTip="TLV Tag 0x45: Bypass onboard DSP mixer and route signals directly"/>

                    <Button Content="CLEAR SOLOS"
                            Command="{Binding ClearAllSolosCommand}"
                            Style="{StaticResource AbletonButtonStyle}"
                            Padding="8,5"
                            Margin="0,0,5,0"/>

                    <Button Content="UNMUTE ALL"
                            Command="{Binding UnmuteAllCommand}"
                            Padding="8,5"
                            Style="{StaticResource AbletonButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- ROW 1: SCENE MEMORY BANK & VIEW SWITCHER BAR                            -->
        <!-- ======================================================================= -->
        <Border Grid.Row="1" Background="#1F1F1F" BorderBrush="#303030" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 10 Scene Memory Preset Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SCENE MEMORY" FontSize="10" FontWeight="Bold" Foreground="#9A9A9A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Scenes}"
                              SelectedItem="{Binding SelectedScene}"
                              DisplayMemberPath="DisplayTitle"
                              Style="{StaticResource AbletonComboBoxStyle}"
                              Width="220"
                              Margin="0,0,6,0"/>

                    <TextBox Text="{Binding EditableSceneName, UpdateSourceTrigger=PropertyChanged}"
                             Width="150"
                             Background="#141414"
                             Foreground="#FFB000"
                             BorderBrush="#424242"
                             BorderThickness="1"
                             Padding="6,3"
                             FontSize="11"
                             FontWeight="SemiBold"
                             VerticalContentAlignment="Center"
                             Margin="0,0,6,0"
                             ToolTip="Scene Name for saving"/>

                    <Button Content="LOAD SCENE"
                            Command="{Binding LoadSceneCommand}"
                            Style="{StaticResource AbletonButtonStyle}"
                            Margin="0,0,4,0"/>

                    <Button Content="SAVE SCENE"
                            Command="{Binding SaveSceneCommand}"
                            Style="{StaticResource AbletonButtonStyle}"
                            Margin="0,0,4,0"/>

                    <Button Content="INIT 0dB"
                            Command="{Binding InitMixerCommand}"
                            Style="{StaticResource AbletonButtonStyle}"
                            Margin="0,0,4,0"/>

                    <Button Content="EXPORT .INI"
                            Command="{Binding ExportSceneIniCommand}"
                            Style="{StaticResource AbletonButtonStyle}"/>
                </StackPanel>

                <!-- Right View Tabs -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="1 // SESSION MIXER &amp; DSP RACK"
                                 IsChecked="{Binding ActiveTabIndex, Converter={x:Static controls:TabIndexConverter.Instance}, ConverterParameter=0}"
                                 Style="{StaticResource AbletonAmberToggleStyle}"
                                 Padding="11,5"
                                 Margin="0,0,4,0"/>
                    <RadioButton Content="2 // LINE OUT 1-8 ROUTING"
                                 IsChecked="{Binding ActiveTabIndex, Converter={x:Static controls:TabIndexConverter.Instance}, ConverterParameter=1}"
                                 Style="{StaticResource AbletonAmberToggleStyle}"
                                 Padding="11,5"
                                 Margin="0,0,4,0"/>
                    <RadioButton Content="3 // USB &amp; DIN MIDI PATCHBAY"
                                 IsChecked="{Binding ActiveTabIndex, Converter={x:Static controls:TabIndexConverter.Instance}, ConverterParameter=2}"
                                 Style="{StaticResource AbletonAmberToggleStyle}"
                                 Padding="11,5"
                                 Margin="0,0,4,0"/>
                    <RadioButton Content="4 // ASIO &amp; USB TLV INSPECTOR"
                                 IsChecked="{Binding ActiveTabIndex, Converter={x:Static controls:TabIndexConverter.Instance}, ConverterParameter=3}"
                                 Style="{StaticResource AbletonAmberToggleStyle}"
                                 Padding="11,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================================= -->
        <!-- ROW 2: MAIN WORKSPACE                                                   -->
        <!-- ======================================================================= -->
        <Grid Grid.Row="2">

            <!-- =================================================================== -->
            <!-- VIEW 0: ABLETON SESSION MIXER (TOP) + DEVICE CHAIN RACK (BOTTOM)    -->
            <!-- =================================================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <!-- Upper Session View Mixer Strips -->
                    <RowDefinition Height="*" MinHeight="380"/>
                    <!-- Splitter -->
                    <RowDefinition Height="4"/>
                    <!-- Lower Ableton Live Device Chain Rack -->
                    <RowDefinition Height="292"/>
                </Grid.RowDefinitions>

                <!-- UPPER PANE: 16 INPUT STRIPS + MASTER BUS STRIP -->
                <Grid Grid.Row="0" Background="#1A1A1A" Margin="6,6,6,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 16 Input Channels Horizontal ScrollViewer -->
                    <ScrollViewer Grid.Column="0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Tracks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Single Ableton Live Session Channel Strip -->
                                    <Border Width="84"
                                            Margin="0,0,2,0"
                                            CornerRadius="2"
                                            MouseLeftButtonDown="OnTrackStripMouseDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#252525"/>
                                                <Setter Property="BorderBrush" Value="#363636"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#2F2F2F"/>
                                                        <Setter Property="BorderBrush" Value="#FFB000"/>
                                                        <Setter Property="BorderThickness" Value="1.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <!-- Track Color Bar -->
                                                <RowDefinition Height="6"/>
                                                <!-- Channel Number & Input Type -->
                                                <RowDefinition Height="34"/>
                                                <!-- Editable Track Name -->
                                                <RowDefinition Height="22"/>
                                                <!-- Stereo Link / Phase / LowCut Row -->
                                                <RowDefinition Height="24"/>
                                                <!-- EQ & Comp Active Status Pills -->
                                                <RowDefinition Height="20"/>
                                                <!-- Pan Knob + Readout -->
                                                <RowDefinition Height="58"/>
                                                <!-- Fader + Peak Meter + GR Meter -->
                                                <RowDefinition Height="*"/>
                                                <!-- Numeric dB Readout -->
                                                <RowDefinition Height="20"/>
                                                <!-- Track Activator (Mute) & Solo Row -->
                                                <RowDefinition Height="30"/>
                                            </Grid.RowDefinitions>

                                            <!-- Row 0: Ableton Track Color Bar -->
                                            <Border Grid.Row="0" Background="{Binding TrackColorHex}" CornerRadius="1,1,0,0"/>

                                            <!-- Row 1: Channel Header -->
                                            <Border Grid.Row="1" Background="#1E1E1E" Padding="4,2" BorderBrush="#323232" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding HeaderTitle}" FontWeight="Bold" FontSize="11" Foreground="#F0F0F0"/>
                                                        <TextBlock Text="{Binding InputTypeLabel}" FontSize="8" Foreground="#888888" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding StereoPairLabel, StringFormat='PAIR {0}'}" FontSize="8" Foreground="#686868"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Row 2: Custom Track Label -->
                                            <TextBox Grid.Row="2"
                                                     Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="#181818"
                                                     Foreground="#DADADA"
                                                     BorderThickness="0,0,0,1"
                                                     BorderBrush="#333333"
                                                     FontSize="10"
                                                     FontWeight="SemiBold"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"/>

                                            <!-- Row 3: Link / Phase / Low Cut Mini Buttons -->
                                            <UniformGrid Grid.Row="3" Columns="3" Margin="3,2">
                                                <ToggleButton Content="LNK"
                                                              IsChecked="{Binding IsStereoLinked}"
                                                              Style="{StaticResource AbletonCyanToggleStyle}"
                                                              FontSize="8.5"
                                                              Margin="1,0"
                                                              ToolTip="Stereo Link Odd/Even Channel Pair"/>
                                                <ToggleButton Content="&#x00D8;"
                                                              IsChecked="{Binding IsPhaseInverted}"
                                                              Style="{StaticResource AbletonAmberToggleStyle}"
                                                              FontSize="9.5"
                                                              Margin="1,0"
                                                              ToolTip="TLV Tag 0x85: Invert Phase Polarity (180°)"/>
                                                <ToggleButton Content="LC"
                                                              IsChecked="{Binding IsLowCutEnabled}"
                                                              Style="{StaticResource AbletonCyanToggleStyle}"
                                                              FontSize="8.5"
                                                              Margin="1,0"
                                                              ToolTip="TLV Tag 0x52: 100 Hz Low Cut Filter"/>
                                            </UniformGrid>

                                            <!-- Row 4: Mini EQ & Comp Active Status Badges -->
                                            <UniformGrid Grid.Row="4" Columns="2" Margin="3,1">
                                                <Border CornerRadius="2" Margin="1,1" Padding="2,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1B1B1B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasActiveEq}" Value="True">
                                                                    <Setter Property="Background" Value="#3E3216"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="EQ4" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#FFB000"/>
                                                </Border>

                                                <Border CornerRadius="2" Margin="1,1" Padding="2,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1B1B1B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasActiveComp}" Value="True">
                                                                    <Setter Property="Background" Value="#143844"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="COMP" FontSize="8.5" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#00D4FF"/>
                                                </Border>
                                            </UniformGrid>

                                            <!-- Row 5: Pan Rotary Knob + Pan Readout -->
                                            <StackPanel Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <controls:AbletonKnob Value="{Binding Pan}"
                                                                      Minimum="-20"
                                                                      Maximum="20"
                                                                      DefaultValue="0"
                                                                      IsBipolar="True"
                                                                      Width="34"
                                                                      Height="34"
                                                                      AccentBrush="{StaticResource AbletonCyan}"
                                                                      ToolTip="TLV Tag 0x82: Channel Pan (L20 .. C .. R20). Double-click to center."/>
                                                <TextBlock Text="{Binding PanDisplay}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="#B8B8B8"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Row 6: Vertical Fader + Peak Meter + GR Meter -->
                                            <Grid Grid.Row="6" Margin="6,2,6,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="7"/>
                                                </Grid.ColumnDefinitions>

                                                <controls:AbletonFader Grid.Column="0"
                                                                       Value="{Binding FaderDb}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Stretch"
                                                                       Height="Auto"
                                                                       ToolTip="TLV Tag 0x81: Channel Fader (-inf to +6.0 dB). Double-click for 0.0 dB."/>

                                                <controls:AbletonLevelMeter Grid.Column="1"
                                                                            Level="{Binding PeakLevelLinear}"
                                                                            PeakHold="{Binding PeakHoldLinear}"
                                                                            Width="8"
                                                                            VerticalAlignment="Stretch"
                                                                            Height="Auto"
                                                                            ToolTip="Input Channel Peak &amp; Hold Meter"/>

                                                <controls:AbletonLevelMeter Grid.Column="2"
                                                                            Level="{Binding Compressor.GainReductionDb}"
                                                                            IsGainReduction="True"
                                                                            Width="5"
                                                                            VerticalAlignment="Stretch"
                                                                            Height="Auto"
                                                                            ToolTip="Compressor Gain Reduction Meter (dB)"/>
                                            </Grid>

                                            <!-- Row 7: Fader dB Box -->
                                            <Border Grid.Row="7" Background="#161616" BorderBrush="#333333" BorderThickness="1" Margin="4,0,4,2" CornerRadius="2">
                                                <TextBlock Text="{Binding FaderDisplay}"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="#FFB000"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Row 8: Ableton Track Activator (Amber) + Solo (Cue Blue) -->
                                            <Grid Grid.Row="8" Margin="4,1,4,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>

                                                <ToggleButton Grid.Column="0"
                                                              Content="{Binding ChannelNumber}"
                                                              IsChecked="{Binding IsTrackActive}"
                                                              Style="{StaticResource AbletonAmberToggleStyle}"
                                                              ToolTip="TLV Tag 0x83: Track Activator (Lit = On / Unmuted, Dark = Muted)"/>

                                                <ToggleButton Grid.Column="2"
                                                              Content="S"
                                                              IsChecked="{Binding IsSolo}"
                                                              Style="{StaticResource AbletonSoloToggleStyle}"
                                                              ToolTip="TLV Tag 0x84: Solo Track"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- DOCKED RIGHT: MASTER STEREO BUS STRIP -->
                    <Border Grid.Column="1"
                            Width="112"
                            Margin="6,0,0,0"
                            Background="#262626"
                            BorderBrush="#FFB000"
                            BorderThickness="1.5"
                            CornerRadius="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="22"/>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="58"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#00D4FF" CornerRadius="1,1,0,0"/>

                            <Border Grid.Row="1" Background="#1A1A1A" Padding="6,2" BorderBrush="#333333" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <TextBlock Text="MASTER L/R" FontWeight="Black" FontSize="11" Foreground="#00D4FF"/>
                                    <TextBlock Text="STEREO BUS" FontSize="8.5" Foreground="#888888"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Background="#161616" BorderBrush="#303030" BorderThickness="0,0,0,1">
                                <TextBlock Text="MAIN OUT 1/2" FontSize="9.5" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="3" Margin="6,4" Background="#1C1C1C" BorderBrush="#343434" BorderThickness="1" CornerRadius="2" Padding="4">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="USB RETURN" FontSize="8" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <ToggleButton Content="DAW &#x2192; MST"
                                                  IsChecked="{Binding ComputerToStereoBus}"
                                                  Style="{StaticResource AbletonAmberToggleStyle}"
                                                  Margin="0,2,0,0"
                                                  Padding="2,2"
                                                  FontSize="8.5"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="SAMPLE RATE" FontSize="8" Foreground="#7A7A7A" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SampleRateDisplay}" FontSize="12" FontWeight="Black" Foreground="#00E676" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="24-BIT DSP" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Master Fader + Dual L/R Meters -->
                            <Grid Grid.Row="5" Margin="10,2,10,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="10"/>
                                </Grid.ColumnDefinitions>

                                <controls:AbletonFader Grid.Column="0"
                                                       Value="{Binding MasterFaderDb}"
                                                       AccentBrush="{StaticResource AbletonCyan}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Stretch"
                                                       Height="Auto"
                                                       ToolTip="TLV Group 2 Tag 0x81: Master Stereo Fader. Double-click for 0.0 dB."/>

                                <controls:AbletonLevelMeter Grid.Column="1"
                                                            Level="{Binding MasterLeftPeak}"
                                                            PeakHold="{Binding MasterLeftHold}"
                                                            Width="8"
                                                            VerticalAlignment="Stretch"
                                                            Height="Auto"
                                                            ToolTip="Master Left Peak Meter"/>

                                <controls:AbletonLevelMeter Grid.Column="2"
                                                            Level="{Binding MasterRightPeak}"
                                                            PeakHold="{Binding MasterRightHold}"
                                                            Width="8"
                                                            VerticalAlignment="Stretch"
                                                            Height="Auto"
                                                            ToolTip="Master Right Peak Meter"/>
                            </Grid>

                            <Border Grid.Row="6" Background="#161616" BorderBrush="#333333" BorderThickness="1" Margin="6,0,6,2" CornerRadius="2">
                                <TextBlock Text="{Binding MasterFaderDisplay}"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="#00D4FF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <Grid Grid.Row="8" Margin="6,1,6,4">
                                <ToggleButton Content="MASTER ON"
                                              IsChecked="{Binding IsMasterActive}"
                                              Style="{StaticResource AbletonAmberToggleStyle}"
                                              ToolTip="TLV Group 2 Tag 0x83: Master Stereo Bus Activator"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SPLITTER -->
                <GridSplitter Grid.Row="1"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="#121212"/>

                <!-- =============================================================== -->
                <!-- LOWER PANE: ABLETON LIVE DEVICE CHAIN RACK FOR SELECTED TRACK   -->
                <!-- =============================================================== -->
                <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="6">
                    <Grid DataContext="{Binding SelectedTrack}">
                        <Grid.ColumnDefinitions>
                            <!-- Device 1: Track Input & High-Pass Filter Stage -->
                            <ColumnDefinition Width="210"/>
                            <!-- Device 2: Ableton EQ Four (Parametric EQ + Curve) -->
                            <ColumnDefinition Width="*"/>
                            <!-- Device 3: Ableton Compressor (Transfer Curve + GR + Knobs) -->
                            <ColumnDefinition Width="470"/>
                        </Grid.ColumnDefinitions>

                        <!-- DEVICE 1: INPUT & PREAMP / LOW-CUT MODULE -->
                        <Border Grid.Column="0" Background="#282828" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Device Title Bar -->
                                <Border Grid.Row="0" Background="#333333" CornerRadius="3,3,0,0" Padding="8,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding TrackColorHex}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding HeaderTitle}" FontWeight="Black" FontSize="11" Foreground="#F0F0F0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding InputTypeLabel}" FontSize="9.5" FontWeight="Bold" Foreground="#FFB000" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Device Body -->
                                <StackPanel Grid.Row="1" Margin="10,8">
                                    <TextBlock Text="TRACK NAME" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#181818"
                                             Foreground="#FFFFFF"
                                             BorderBrush="#424242"
                                             BorderThickness="1"
                                             Padding="6,4"
                                             FontSize="12"
                                             FontWeight="Bold"
                                             Margin="0,0,0,10"/>

                                    <TextBlock Text="INPUT STAGE &amp; POLARITY" FontSize="9" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,4"/>
                                    <ToggleButton Content="STEREO LINK PAIR"
                                                  IsChecked="{Binding IsStereoLinked}"
                                                  Style="{StaticResource AbletonCyanToggleStyle}"
                                                  Padding="8,6"
                                                  Margin="0,0,0,6"/>

                                    <ToggleButton Content="&#x00D8; PHASE INVERT (180°)"
                                                  IsChecked="{Binding IsPhaseInverted}"
                                                  Style="{StaticResource AbletonAmberToggleStyle}"
                                                  Padding="8,6"
                                                  Margin="0,0,0,6"/>

                                    <ToggleButton Content="100 Hz LOW CUT (HPF)"
                                                  IsChecked="{Binding IsLowCutEnabled}"
                                                  Style="{StaticResource AbletonCyanToggleStyle}"
                                                  Padding="8,6"
                                                  Margin="0,0,0,8"/>

                                    <Border Background="#1B1B1B" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Padding="6,4">
                                        <Grid>
                                            <TextBlock Text="PEAK LEVEL:" FontSize="9.5" Foreground="#888888" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PeakDbDisplay, StringFormat='{}{0} dB'}" FontSize="10.5" FontWeight="Bold" Foreground="#00E676" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DEVICE 2: ABLETON EQ FOUR (EQ EIGHT STYLE) -->
                        <Border Grid.Column="1" Background="#282828" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Device Title Bar -->
                                <Border Grid.Row="0" Background="#333333" CornerRadius="3,3,0,0" Padding="8,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton Content="ON"
                                                          IsChecked="{Binding IsEqEnabled}"
                                                          Style="{StaticResource AbletonAmberToggleStyle}"
                                                          Padding="6,1"
                                                          Margin="0,0,8,0"/>
                                            <TextBlock Text="EQ FOUR // 4-BAND PARAMETRIC DSP EQ" FontWeight="Bold" FontSize="11" Foreground="#F0F0F0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Drag nodes 1-4  |  Wheel = Q  |  Dbl-Click = 0 dB" FontSize="9.5" Foreground="#909090" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Button Content="FLAT 0dB"
                                                    Command="{Binding DataContext.ResetSelectedEqCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Style="{StaticResource AbletonButtonStyle}"
                                                    Padding="8,2"
                                                    FontSize="9.5"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- EQ Curve Display + 4 Band Strip Controls -->
                                <Grid Grid.Row="1" Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="260"/>
                                        <ColumnDefinition Width="340"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Interactive Frequency Response Curve -->
                                    <controls:EqCurveControl Grid.Column="0"
                                                             Track="{Binding}"
                                                             Margin="0,0,8,0"/>

                                    <!-- 4 Band Knobs Matrix -->
                                    <UniformGrid Grid.Column="1" Columns="4">
                                        <!-- BAND 1: LOW SHELF -->
                                        <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Margin="2,0" Padding="4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Background="#FF5252" CornerRadius="2" Padding="6,1" Margin="0,0,0,4">
                                                    <TextBlock Text="1 LOW" FontSize="9" FontWeight="Black" Foreground="#121212" HorizontalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Text="FREQ" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <controls:AbletonKnob Value="{Binding LowBand.FrequencyHz}"
                                                                      Minimum="32" Maximum="1000" DefaultValue="100"
                                                                      IsLogarithmic="True"
                                                                      Width="34" Height="34"
                                                                      AccentBrush="#FF5252"/>
                                                <TextBlock Text="{Binding LowBand.FrequencyDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                                <TextBlock Text="GAIN" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <controls:AbletonKnob Value="{Binding LowBand.GainDb}"
                                                                      Minimum="-12" Maximum="12" DefaultValue="0"
                                                                      IsBipolar="True"
                                                                      Width="34" Height="34"
                                                                      AccentBrush="#FF5252"/>
                                                <TextBlock Text="{Binding LowBand.GainDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="#FF5252" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                                                <TextBlock Text="TYPE" FontSize="8.5" Foreground="#666666" HorizontalAlignment="Center"/>
                                                <TextBlock Text="LOW SHELF" FontSize="8.5" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- BAND 2: LOW-MID BELL -->
                                        <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Margin="2,0" Padding="4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Background="#FFB000" CornerRadius="2" Padding="6,1" Margin="0,0,0,4">
                                                    <TextBlock Text="2 LO-MID" FontSize="9" FontWeight="Black" Foreground="#121212" HorizontalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Text="FREQ" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <controls:AbletonKnob Value="{Binding LowMidBand.FrequencyHz}"
                                                                      Minimum="32" Maximum="18000" DefaultValue="400"
                                                                      IsLogarithmic="True"
                                                                      Width="34" Height="34"
                                                                      AccentBrush="#FFB000"/>
                                                <TextBlock Text="{Binding LowMidBand.FrequencyDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                                <TextBlock Text="GAIN" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <controls:AbletonKnob Value="{Binding LowMidBand.GainDb}"
                                                                      Minimum="-12" Maximum="12" DefaultValue="0"
                                                                      IsBipolar="True"
                                                                      Width="34" Height="34"
                                                                      AccentBrush="#FFB000"/>
                                                <TextBlock Text="{Binding LowMidBand.GainDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="#FFB000" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                                <TextBlock Text="Q FACTOR" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <controls:AbletonKnob Value="{Binding LowMidBand.QFactor}"
                                                                      Minimum="0.25" Maximum="16.0" DefaultValue="1.0"
                                                                      IsLogarithmic="True"
                                                                      Width="28" Height="28"
                                                                      AccentBrush="#FFB000"/>
                                                <TextBlock Text="{Binding LowMidBand.QDisplay}" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- BAND 3: HIGH-MID BELL -->
                                        <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Margin="2,0" Padding="4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Background="#00E676" CornerRadius="2" Padding="6,1" Margin="0,0,0,4">
                                                    <TextBlock Text="3 HI-MID" FontSize="9" FontWeight="Black" Foreground="#121212" HorizontalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Text="FREQ" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <controls:AbletonKnob Value="{Binding HighMidBand.FrequencyHz}"
                                                                      Minimum="32" Maximum="18000" DefaultValue="2500"
                                                                      IsLogarithmic="True"
                                                                      Width="34" Height="34"
                                                                      AccentBrush="#00E676"/>
                                                <TextBlock Text="{Binding HighMidBand.FrequencyDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                                <TextBlock Text="GAIN" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <controls:AbletonKnob Value="{Binding HighMidBand.GainDb}"
                                                                      Minimum="-12" Maximum="12" DefaultValue="0"
                                                                      IsBipolar="True"
                                                                      Width="34" Height="34"
                                                                      AccentBrush="#00E676"/>
                                                <TextBlock Text="{Binding HighMidBand.GainDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="#00E676" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                                <TextBlock Text="Q FACTOR" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <controls:AbletonKnob Value="{Binding HighMidBand.QFactor}"
                                                                      Minimum="0.25" Maximum="16.0" DefaultValue="1.0"
                                                                      IsLogarithmic="True"
                                                                      Width="28" Height="28"
                                                                      AccentBrush="#00E676"/>
                                                <TextBlock Text="{Binding HighMidBand.QDisplay}" FontSize="9" FontWeight="Bold" Foreground="#CCCCCC" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- BAND 4: HIGH SHELF -->
                                        <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Margin="2,0" Padding="4">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Background="#00D4FF" CornerRadius="2" Padding="6,1" Margin="0,0,0,4">
                                                    <TextBlock Text="4 HIGH" FontSize="9" FontWeight="Black" Foreground="#121212" HorizontalAlignment="Center"/>
                                                </Border>

                                                <TextBlock Text="FREQ" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <controls:AbletonKnob Value="{Binding HighBand.FrequencyHz}"
                                                                      Minimum="1000" Maximum="18000" DefaultValue="8000"
                                                                      IsLogarithmic="True"
                                                                      Width="34" Height="34"
                                                                      AccentBrush="#00D4FF"/>
                                                <TextBlock Text="{Binding HighBand.FrequencyDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                                <TextBlock Text="GAIN" FontSize="8.5" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <controls:AbletonKnob Value="{Binding HighBand.GainDb}"
                                                                      Minimum="-12" Maximum="12" DefaultValue="0"
                                                                      IsBipolar="True"
                                                                      Width="34" Height="34"
                                                                      AccentBrush="#00D4FF"/>
                                                <TextBlock Text="{Binding HighBand.GainDisplay}" FontSize="9.5" FontWeight="Bold" Foreground="#00D4FF" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                                                <TextBlock Text="TYPE" FontSize="8.5" Foreground="#666666" HorizontalAlignment="Center"/>
                                                <TextBlock Text="HI SHELF" FontSize="8.5" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- DEVICE 3: ABLETON COMPRESSOR MODULE -->
                        <Border Grid.Column="2" Background="#282828" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="3">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Device Title Bar -->
                                <Border Grid.Row="0" Background="#333333" CornerRadius="3,3,0,0" Padding="8,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton Content="ON"
                                                          IsChecked="{Binding Compressor.IsEnabled}"
                                                          Style="{StaticResource AbletonAmberToggleStyle}"
                                                          Padding="6,1"
                                                          Margin="0,0,8,0"/>
                                            <TextBlock Text="COMPRESSOR // DSP DYNAMICS" FontWeight="Bold" FontSize="11" Foreground="#F0F0F0" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Button Content="RESET"
                                                Command="{Binding DataContext.ResetSelectedCompCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource AbletonButtonStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Padding="8,2"
                                                FontSize="9.5"/>
                                    </Grid>
                                </Border>

                                <!-- Compressor Body -->
                                <Grid Grid.Row="1" Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <!-- Transfer Curve -->
                                        <ColumnDefinition Width="164"/>
                                        <!-- Vertical GR Meter -->
                                        <ColumnDefinition Width="50"/>
                                        <!-- 5 Parameter Knobs -->
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <controls:CompressorCurveControl Grid.Column="0"
                                                                     Track="{Binding}"
                                                                     ToolTip="Compressor Transfer Curve — Drag horizontally to set Threshold"/>

                                    <!-- Dedicated Gain Reduction Bar -->
                                    <Border Grid.Column="1" Background="#1B1B1B" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Margin="5,0" Padding="2,4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="GR" FontSize="8.5" FontWeight="Black" Foreground="#FF9100" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                            <controls:AbletonLevelMeter Grid.Row="1"
                                                                        Level="{Binding Compressor.GainReductionDb}"
                                                                        IsGainReduction="True"
                                                                        Width="12"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Stretch"
                                                                        Height="Auto"/>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Compressor.GainReductionDisplay}"
                                                       FontSize="8"
                                                       FontWeight="Bold"
                                                       Foreground="#FF9100"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,3,0,0"/>
                                        </Grid>
                                    </Border>

                                    <!-- 5 Rotary Knobs: Threshold, Ratio, Attack, Release, Makeup Gain -->
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Threshold -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="THRESH" FontSize="9" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Center"/>
                                            <controls:AbletonKnob Value="{Binding Compressor.ThresholdDb}"
                                                                  Minimum="-32" Maximum="0" DefaultValue="-16"
                                                                  Width="38" Height="38"
                                                                  AccentBrush="{StaticResource AbletonCyan}"/>
                                            <TextBlock Text="{Binding Compressor.ThresholdDisplay}" FontSize="10" FontWeight="Bold" Foreground="#00D4FF" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Ratio -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="RATIO" FontSize="9" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Center"/>
                                            <controls:AbletonKnob Value="{Binding Compressor.RatioKnobValue}"
                                                                  Minimum="0" Maximum="13" DefaultValue="5"
                                                                  Width="38" Height="38"
                                                                  AccentBrush="{StaticResource AbletonAmber}"/>
                                            <TextBlock Text="{Binding Compressor.RatioDisplay}" FontSize="10" FontWeight="Bold" Foreground="#FFB000" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Makeup Gain -->
                                        <StackPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="MAKEUP" FontSize="9" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Center"/>
                                            <controls:AbletonKnob Value="{Binding Compressor.MakeupGainDb}"
                                                                  Minimum="0" Maximum="20" DefaultValue="0"
                                                                  Width="38" Height="38"
                                                                  AccentBrush="{StaticResource AbletonGreen}"/>
                                            <TextBlock Text="{Binding Compressor.MakeupGainDisplay}" FontSize="10" FontWeight="Bold" Foreground="#00E676" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Attack -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="ATTACK" FontSize="9" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Center"/>
                                            <controls:AbletonKnob Value="{Binding Compressor.AttackMs}"
                                                                  Minimum="2" Maximum="200" DefaultValue="20"
                                                                  Width="38" Height="38"
                                                                  AccentBrush="{StaticResource AbletonAmber}"/>
                                            <TextBlock Text="{Binding Compressor.AttackDisplay}" FontSize="10" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Release -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="RELEASE" FontSize="9" FontWeight="Bold" Foreground="#999999" HorizontalAlignment="Center"/>
                                            <controls:AbletonKnob Value="{Binding Compressor.ReleaseMs}"
                                                                  Minimum="10" Maximum="1000" DefaultValue="100"
                                                                  Width="38" Height="38"
                                                                  AccentBrush="{StaticResource AbletonAmber}"/>
                                            <TextBlock Text="{Binding Compressor.ReleaseDisplay}" FontSize="10" FontWeight="Bold" Foreground="#E0E0E0" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Sidechain Link Info -->
                                        <Border Grid.Row="1" Grid.Column="2" Background="#1E1E1E" BorderBrush="#383838" BorderThickness="1" CornerRadius="2" Margin="4,8" Padding="4">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="DETECTOR" FontSize="8" Foreground="#888888" HorizontalAlignment="Center"/>
                                                <TextBlock Text="RMS / PEAK" FontSize="9" FontWeight="Bold" Foreground="#FFB000" HorizontalAlignment="Center" Margin="0,2"/>
                                                <ToggleButton Content="STEREO LINK"
                                                              IsChecked="{Binding IsStereoLinked}"
                                                              Style="{StaticResource AbletonCyanToggleStyle}"
                                                              FontSize="8"
                                                              Padding="4,2"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- =================================================================== -->
            <!-- VIEW 1: LINE OUT 1-8 VISUAL PATCHBAY & CROSSPOINT MATRIX            -->
            <!-- =================================================================== -->
            <Border Background="#1A1A1A" Padding="18">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header + Quick Routing Presets -->
                    <Border Grid.Row="0" Background="#252525" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="3" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="LINE OUT 1–8 VISUAL HARDWARE PATCHBAY &amp; 10×8 CROSSPOINT MATRIX" FontSize="14" FontWeight="Black" Foreground="#FFB000"/>
                                <TextBlock Text="Drag virtual 1/4&quot; TRS patch cables between Sources and Line Outputs, or click any intersection in the 10×8 Crosspoint Matrix."
                                           FontSize="11" Foreground="#B0B0B0" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="STUDIO DEFAULT (1-2 MASTER, 3-8 DAW)"
                                        Command="{Binding ApplyRoutingPresetCommand}"
                                        CommandParameter="Studio"
                                        Style="{StaticResource AbletonButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Content="8-CH DAW STEMS (1-8 DIRECT)"
                                        Command="{Binding ApplyRoutingPresetCommand}"
                                        CommandParameter="DirectDAW"
                                        Style="{StaticResource AbletonButtonStyle}"
                                        Margin="0,0,8,0"/>
                                <Button Content="ALL MASTER L/R MIRROR"
                                        Command="{Binding ApplyRoutingPresetCommand}"
                                        CommandParameter="AllMaster"
                                        Style="{StaticResource AbletonButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Interactive Visual Cable Patchbay + 10x8 Crosspoint Matrix -->
                    <controls:RoutingPatchbayControl Grid.Row="1"
                                                     Routes="{Binding LineOutRoutes}"/>
                </Grid>
            </Border>

            <!-- =================================================================== -->
            <!-- VIEW 2: USB & 5-PIN DIN MIDI PATCHBAY, CHANNEL REMAP & LIVE MONITOR -->
            <!-- =================================================================== -->
            <Border Background="#1A1A1A" Padding="14,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header & Studio MIDI Presets -->
                        <RowDefinition Height="Auto"/>
                        <!-- Visual MIDI Patchbay + Many-to-Many Crosspoint Matrix -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Rack: Per-Route Channel Filter/Remap + Live MIDI Event Monitor -->
                        <RowDefinition Height="240"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header + Studio Presets + Global Panic -->
                    <Border Grid.Row="0" Background="#252525" BorderBrush="#3E3E3E" BorderThickness="1" CornerRadius="3" Padding="14,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="USB &amp; 5-PIN DIN MIDI PATCHBAY // ROUTER &amp; CHANNEL PROCESSOR"
                                               FontSize="13" FontWeight="Black" Foreground="#FFB000"/>
                                    <Border Background="#161616" BorderBrush="#383838" BorderThickness="1" CornerRadius="2" Padding="8,2" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="CLOCK: " FontSize="9.5" FontWeight="Bold" Foreground="#888888"/>
                                            <TextBlock Text="{Binding MidiClockDisplay}" FontSize="9.5" FontWeight="Black" Foreground="#00D4FF"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Drag MIDI cables between jacks, click matrix cells to toggle patches, or click any cable badge to edit Channel Filter &amp; Remap."
                                           FontSize="10" Foreground="#B0B0B0" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="LAUNCHKEY &#x2192; ALL SYNTHS"
                                        Command="{Binding ApplyMidiPresetCommand}"
                                        CommandParameter="LaunchkeyAllSynths"
                                        Style="{StaticResource AbletonButtonStyle}"
                                        Margin="0,0,6,0"
                                        ToolTip="Route Launchkey MK4 49 MIDI to US-16x08 DIN and all connected USB hardware synths"/>
                                <Button Content="US-16x08 DIN &#x2194; USB BRIDGE"
                                        Command="{Binding ApplyMidiPresetCommand}"
                                        CommandParameter="DinToUsbBridge"
                                        Style="{StaticResource AbletonButtonStyle}"
                                        Margin="0,0,6,0"
                                        ToolTip="Bridge TASCAM US-16x08 5-pin DIN MIDI In to all USB Synths, and Launchkey to US-16x08 5-pin DIN Out"/>
                                <Button Content="KEY SPLIT @ C4"
                                        Command="{Binding ApplyMidiPresetCommand}"
                                        CommandParameter="SplitSynthStack"
                                        Style="{StaticResource AbletonButtonStyle}"
                                        Margin="0,0,6,0"
                                        ToolTip="Split keyboard at Middle C (C4 / Note 60): Lower Bass Synths (C-1..B3) and Upper Lead Synths (C4..G9)"/>
                                <Button Content="CLEAR PATCHES"
                                        Command="{Binding ApplyMidiPresetCommand}"
                                        CommandParameter="ClearAll"
                                        Style="{StaticResource AbletonButtonStyle}"
                                        Margin="0,0,6,0"/>
                                <Button Content="RESCAN MIDI"
                                        Command="{Binding RescanMidiPortsCommand}"
                                        Style="{StaticResource AbletonButtonStyle}"
                                        Margin="0,0,6,0"/>
                                <Button Content="ALL NOTES OFF (PANIC !)"
                                        Command="{Binding GlobalMidiPanicCommand}"
                                        Style="{StaticResource AbletonButtonStyle}"
                                        Foreground="#FF5252"
                                        BorderBrush="#993333"
                                        FontWeight="Black"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Interactive Visual MIDI Patchbay + Many-to-Many Crosspoint Matrix -->
                    <controls:MidiPatchbayControl x:Name="MidiPatchbay"
                                                  Grid.Row="1"
                                                  Margin="0,0,0,8"
                                                  InputPorts="{Binding MidiInputPorts}"
                                                  OutputPorts="{Binding MidiOutputPorts}"
                                                  Routes="{Binding MidiRoutes}"
                                                  SelectedRoute="{Binding SelectedMidiRoute, Mode=TwoWay}"/>

                    <!-- Row 2: Bottom Rack (Left: Per-Route Channel Filter & Remap Inspector | Right: Live MIDI Activity Monitor) -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.0*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT: Per-Route Channel Filtering, Remapping, Key Split & Message Filter Inspector -->
                        <Border Grid.Column="0" Background="#232323" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="3" Padding="12,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Inspector Top Row: Route Selector + Quick Route Actions -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Border Background="#FFB000" Width="4" Height="16" CornerRadius="1" Margin="0,0,7,0"/>
                                        <TextBlock Text="ROUTE FILTER &amp; CHANNEL REMAP" FontSize="11.5" FontWeight="Black" Foreground="#FFB000" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding MidiRoutes}"
                                              SelectedItem="{Binding SelectedMidiRoute}"
                                              DisplayMemberPath="RouteTitle"
                                              Style="{StaticResource AbletonComboBoxStyle}"
                                              Margin="0,0,8,0"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                IsEnabled="{Binding HasSelectedMidiRoute}">
                                        <ToggleButton Content="ROUTE ACTIVE"
                                                      IsChecked="{Binding SelectedMidiRoute.IsEnabled}"
                                                      Style="{StaticResource AbletonAmberToggleStyle}"
                                                      Padding="8,3"
                                                      Margin="0,0,5,0"/>
                                        <Button Content="TEST C4"
                                                Command="{Binding AuditionMidiPortCommand}"
                                                Style="{StaticResource AbletonButtonStyle}"
                                                Padding="8,3"
                                                Margin="0,0,5,0"
                                                ToolTip="Send a 240ms C4 test note to this route's destination synth"/>
                                        <Button Content="PORT PANIC"
                                                Command="{Binding PortMidiPanicCommand}"
                                                Style="{StaticResource AbletonButtonStyle}"
                                                Foreground="#FF5252"
                                                Padding="8,3"
                                                Margin="0,0,5,0"
                                                ToolTip="Send All Notes Off (CC#123) to this route's destination port"/>
                                        <Button Content="RESET"
                                                Command="{Binding ResetSelectedMidiRouteFilterCommand}"
                                                Style="{StaticResource AbletonButtonStyle}"
                                                Padding="8,3"
                                                Margin="0,0,5,0"/>
                                        <Button Content="REMOVE"
                                                Command="{Binding RemoveSelectedMidiRouteCommand}"
                                                Style="{StaticResource AbletonButtonStyle}"
                                                Padding="8,3"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1: Channel Filter, Channel Remap, Semitone Transpose & Note Range Split -->
                                <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#323232" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8"
                                        IsEnabled="{Binding HasSelectedMidiRoute}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="1.25*"/>
                                            <ColumnDefinition Width="1.25*"/>
                                            <ColumnDefinition Width="1.15*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Source Channel Filter -->
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="SOURCE CHANNEL FILTER" FontSize="9" FontWeight="Bold" Foreground="#9A9A9A" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AvailableSourceChannelFilters}"
                                                      SelectedIndex="{Binding SelectedMidiRoute.SourceChannelFilter}"
                                                      Style="{StaticResource AbletonComboBoxStyle}"/>
                                            <TextBlock Text="Only pass input matching Ch" FontSize="8.5" Foreground="#686868" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Destination Channel Remap -->
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock Text="DESTINATION CHANNEL REMAP" FontSize="9" FontWeight="Bold" Foreground="#00D4FF" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding AvailableTargetChannelRemaps}"
                                                      SelectedIndex="{Binding SelectedMidiRoute.TargetChannelRemap}"
                                                      Style="{StaticResource AbletonComboBoxStyle}"/>
                                            <TextBlock Text="Rewrite outgoing MIDI channel" FontSize="8.5" Foreground="#686868" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Semitone / Octave Transpose -->
                                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="TRANSPOSE: " FontSize="9" FontWeight="Bold" Foreground="#9A9A9A"/>
                                                <TextBlock Text="{Binding SelectedMidiRoute.TransposeDisplay}" FontSize="9.5" FontWeight="Black" Foreground="#FFB000"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="-12 OCT" Command="{Binding TransposeOctaveCommand}" CommandParameter="-12" Style="{StaticResource AbletonButtonStyle}" Padding="6,2" Margin="0,0,4,0"/>
                                                <Button Content="-1" Command="{Binding TransposeOctaveCommand}" CommandParameter="-1" Style="{StaticResource AbletonButtonStyle}" Padding="6,2" Margin="0,0,4,0"/>
                                                <Button Content="0" Command="{Binding TransposeOctaveCommand}" CommandParameter="0" Style="{StaticResource AbletonButtonStyle}" Padding="6,2" Margin="0,0,4,0"/>
                                                <Button Content="+1" Command="{Binding TransposeOctaveCommand}" CommandParameter="1" Style="{StaticResource AbletonButtonStyle}" Padding="6,2" Margin="0,0,4,0"/>
                                                <Button Content="+12 OCT" Command="{Binding TransposeOctaveCommand}" CommandParameter="12" Style="{StaticResource AbletonButtonStyle}" Padding="6,2"/>
                                            </StackPanel>
                                            <TextBlock Text="Shifts Note On/Off (-36..+36 ST)" FontSize="8.5" Foreground="#686868" Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <!-- Keyboard Split / Note Range -->
                                        <StackPanel Grid.Column="3">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="KEY ZONE: " FontSize="9" FontWeight="Bold" Foreground="#9A9A9A"/>
                                                <TextBlock Text="{Binding SelectedMidiRoute.MinNoteDisplay}" FontSize="9" FontWeight="Bold" Foreground="#00E676"/>
                                                <TextBlock Text=" .. " FontSize="9" Foreground="#888888"/>
                                                <TextBlock Text="{Binding SelectedMidiRoute.MaxNoteDisplay}" FontSize="9" FontWeight="Bold" Foreground="#00E676"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider Grid.Column="0" Minimum="0" Maximum="127" Value="{Binding SelectedMidiRoute.MinNote}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="Lowest MIDI Note passed"/>
                                                <Slider Grid.Column="2" Minimum="0" Maximum="127" Value="{Binding SelectedMidiRoute.MaxNote}" TickFrequency="1" IsSnapToTickEnabled="True" ToolTip="Highest MIDI Note passed"/>
                                            </Grid>
                                            <TextBlock Text="Low / High Note Split Filter" FontSize="8.5" Foreground="#686868" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Row 2: Message Type Filter Toggles -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            IsEnabled="{Binding HasSelectedMidiRoute}">
                                    <TextBlock Text="PASS MESSAGES:" FontSize="9.5" FontWeight="Bold" Foreground="#9A9A9A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ToggleButton Content="NOTES (ON/OFF)"
                                                  IsChecked="{Binding SelectedMidiRoute.PassNotes}"
                                                  Style="{StaticResource AbletonAmberToggleStyle}"
                                                  Padding="9,4" Margin="0,0,5,0"/>
                                    <ToggleButton Content="CONTROL CHG (CC)"
                                                  IsChecked="{Binding SelectedMidiRoute.PassControlChange}"
                                                  Style="{StaticResource AbletonAmberToggleStyle}"
                                                  Padding="9,4" Margin="0,0,5,0"/>
                                    <ToggleButton Content="PITCH BEND"
                                                  IsChecked="{Binding SelectedMidiRoute.PassPitchBend}"
                                                  Style="{StaticResource AbletonAmberToggleStyle}"
                                                  Padding="9,4" Margin="0,0,5,0"/>
                                    <ToggleButton Content="AFTERTOUCH"
                                                  IsChecked="{Binding SelectedMidiRoute.PassAftertouch}"
                                                  Style="{StaticResource AbletonAmberToggleStyle}"
                                                  Padding="9,4" Margin="0,0,5,0"/>
                                    <ToggleButton Content="PROGRAM CHG"
                                                  IsChecked="{Binding SelectedMidiRoute.PassProgramChange}"
                                                  Style="{StaticResource AbletonAmberToggleStyle}"
                                                  Padding="9,4" Margin="0,0,5,0"/>
                                    <ToggleButton Content="CLOCK &amp; TRANSPORT (0xF8)"
                                                  IsChecked="{Binding SelectedMidiRoute.PassClockAndTransport}"
                                                  Style="{StaticResource AbletonCyanToggleStyle}"
                                                  Padding="9,4" Margin="0,0,5,0"/>
                                    <ToggleButton Content="SYSEX"
                                                  IsChecked="{Binding SelectedMidiRoute.PassSysEx}"
                                                  Style="{StaticResource AbletonCyanToggleStyle}"
                                                  Padding="9,4"/>
                                </StackPanel>

                                <!-- Row 3: Summary Line -->
                                <Border Grid.Row="3" Background="#161616" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="2" Padding="8,4" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="ACTIVE RULE SUMMARY // " FontSize="9" FontWeight="Bold" Foreground="#888888"/>
                                        <TextBlock Text="{Binding SelectedMidiRoute.RouteTitle, FallbackValue='Select or create a MIDI patch cable above'}" FontSize="9.5" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding SelectedMidiRoute.FilterSummary}" FontSize="9.5" FontWeight="Black" Foreground="#00D4FF" Margin="0,0,14,0"/>
                                        <TextBlock Text="ROUTED EVENTS: " FontSize="9" FontWeight="Bold" Foreground="#888888"/>
                                        <TextBlock Text="{Binding SelectedMidiRoute.RoutedCount, FallbackValue=0}" FontSize="9.5" FontWeight="Bold" Foreground="#00E676"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- RIGHT: Live MIDI Activity Monitor & Event Decoder -->
                        <Border Grid.Column="2" Background="#232323" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="3" Padding="12,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#00E676" Width="4" Height="16" CornerRadius="1" Margin="0,0,7,0"/>
                                        <TextBlock Text="LIVE MIDI ACTIVITY MONITOR" FontSize="11.5" FontWeight="Black" Foreground="#00E676" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ToggleButton Content="HIDE 0xF8 CLOCK"
                                                      IsChecked="{Binding FilterMidiClockFromLog}"
                                                      Style="{StaticResource AbletonCyanToggleStyle}"
                                                      Padding="7,2"
                                                      Margin="0,0,5,0"
                                                      ToolTip="Filter high-frequency 24 PPQN MIDI Timing Clock (0xF8) ticks from scrolling the monitor"/>
                                        <ToggleButton Content="PAUSE"
                                                      IsChecked="{Binding IsMidiMonitorPaused}"
                                                      Style="{StaticResource AbletonAmberToggleStyle}"
                                                      Padding="7,2"
                                                      Margin="0,0,5,0"/>
                                        <Button Content="CLEAR"
                                                Command="{Binding ClearMidiMonitorCommand}"
                                                Style="{StaticResource AbletonButtonStyle}"
                                                Padding="7,2"/>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="#121212" BorderBrush="#303030" BorderThickness="1" CornerRadius="2" Padding="4">
                                    <ListBox ItemsSource="{Binding MidiEventLog}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontFamily="Consolas"
                                             FontSize="10">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FormattedLine}"
                                                           Foreground="{Binding AccentHex}"
                                                           Margin="0,0.5"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- =================================================================== -->
            <!-- VIEW 3: INTERFACE / ASIO SETTINGS & LIVE USB TLV PACKET INSPECTOR   -->
            <!-- =================================================================== -->
            <Border Background="#1A1A1A" Padding="24">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveTabIndex}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid MaxWidth="1220" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Hardware & ASIO Driver Configuration -->
                    <Border Grid.Column="0" Background="#252525" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="3" Padding="18">
                        <StackPanel>
                            <TextBlock Text="HARDWARE &amp; ASIO DRIVER CONFIGURATION" FontSize="13" FontWeight="Black" Foreground="#FFB000" Margin="0,0,0,14"/>

                            <TextBlock Text="KERNEL STREAMING DEVICE HANDLE PATH" FontSize="9.5" FontWeight="Bold" Foreground="#888888"/>
                            <Border Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,12">
                                <TextBlock Text="{Binding DevicePathText}" FontSize="10.5" FontFamily="Consolas" Foreground="#00D4FF" TextWrapping="Wrap"/>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="FIRMWARE VERSION" FontSize="9.5" FontWeight="Bold" Foreground="#888888"/>
                                    <Border Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding FirmwareVersionText}" FontSize="11" FontWeight="Bold" Foreground="#E0E0E0"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="WINDOWS DRIVER" FontSize="9.5" FontWeight="Bold" Foreground="#888888"/>
                                    <Border Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding DriverVersionText}" FontSize="11" FontWeight="Bold" Foreground="#00E676"/>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="ASIO BUFFER SIZE (HKCU\Software\TASCAM\US-16x08\ASIODRIVER\blockFrames)" FontSize="9.5" FontWeight="Bold" Foreground="#888888"/>
                            <ComboBox ItemsSource="{Binding AvailableBufferSizes}"
                                      SelectedItem="{Binding AsioBufferSize}"
                                      Style="{StaticResource AbletonComboBoxStyle}"
                                      Margin="0,4,0,12"
                                      Padding="10,6"
                                      FontSize="12"/>

                            <TextBlock Text="ROUND-TRIP LATENCY ESTIMATE" FontSize="9.5" FontWeight="Bold" Foreground="#888888"/>
                            <Border Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,4,0,14">
                                <TextBlock Text="{Binding LatencyEstimateText}" FontSize="12" FontWeight="Bold" Foreground="#FFB000"/>
                            </Border>

                            <TextBlock Text="REVERSE-ENGINEERED DRIVER IOCTL SPECIFICATION" FontSize="9.5" FontWeight="Bold" Foreground="#888888" Margin="0,4,0,4"/>
                            <Border Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="&#x2022; KSCATEGORY_RENDER: {65E8773E-8F56-11D0-A3B9-00A0C9223196}" FontFamily="Consolas" FontSize="9.5" Foreground="#B8B8B8" Margin="0,1"/>
                                    <TextBlock Text="&#x2022; Vendor Control IOCTL: 0x00222000 (bRequest 0x1D Write / 0x1E Read)" FontFamily="Consolas" FontSize="9.5" Foreground="#B8B8B8" Margin="0,1"/>
                                    <TextBlock Text="&#x2022; Sample Rate IOCTL:    0x0022606C (Returns uint32 Hz)" FontFamily="Consolas" FontSize="9.5" Foreground="#B8B8B8" Margin="0,1"/>
                                    <TextBlock Text="&#x2022; TLV Ready Handshake:  [0xA1, 0x02, 0x00]" FontFamily="Consolas" FontSize="9.5" Foreground="#B8B8B8" Margin="0,1"/>
                                    <TextBlock Text="&#x2022; EQ / Comp / Fader:    Tags 0x51..0x55, 0x91..0x97, 0x81..0x85" FontFamily="Consolas" FontSize="9.5" Foreground="#B8B8B8" Margin="0,1"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right Column: Live 64-Byte USB TLV Frame Inspector -->
                    <Border Grid.Column="2" Background="#252525" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="3" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="LIVE USB / IOCTL 0x00222000 TLV PACKET STREAM" FontSize="13" FontWeight="Black" Foreground="#00D4FF"/>
                                    <TextBlock Text="Real-time hexadecimal trace of 64-byte TLV frames formatted for the TASCAM US-16x08 onboard DSP." FontSize="10.5" Foreground="#999999"/>
                                </StackPanel>
                                <Button Content="CLEAR LOG"
                                        Command="{Binding ClearPacketLogCommand}"
                                        Style="{StaticResource AbletonButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <Border Grid.Row="1" Background="#121212" BorderBrush="#333333" BorderThickness="1" CornerRadius="2" Padding="6">
                                <ListBox ItemsSource="{Binding PacketLog}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#00E676"
                                         FontFamily="Consolas"
                                         FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================================================================= -->
        <!-- ROW 3: BOTTOM ABLETON INFO / STATUS BAR                                 -->
        <!-- ======================================================================= -->
        <Border Grid.Row="3" Background="#141414" BorderBrush="#2C2C2C" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="INFO //" FontSize="10" FontWeight="Black" Foreground="#FFB000" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="10.5" Foreground="#CCCCCC"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="SELECTED TRACK: " FontSize="9.5" FontWeight="Bold" Foreground="#777777"/>
                    <TextBlock Text="{Binding SelectedTrack.HeaderTitle}" FontSize="9.5" FontWeight="Bold" Foreground="#FFB000" Margin="0,0,12,0"/>
                    <TextBlock Text="DRIVER: US-16x08 IOCTL 0x00222000" FontSize="9.5" FontFamily="Consolas" Foreground="#777777"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
